# Mapbox access token, used for geocoding addresses and static map previews
# on a participant's profile screen. Get one at https://account.mapbox.com/access-tokens/
#
# Optional: this is a build-time fallback. Users can also paste their own
# token in the Settings panel (Style -> Map), stored in the browser; a token
# entered there always takes precedence over this variable.
VITE_MAPBOX_TOKEN=
